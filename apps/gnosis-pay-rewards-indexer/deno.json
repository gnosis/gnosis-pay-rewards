{
  "tasks": {
    "dev": "deno run -A --watch src/index.ts",
    "dev:inspect": "deno run -A --watch --inspect src/index.ts",
    "start": "deno run -A src/start-all.ts",
    "test": "NODE_ENV=test deno test --allow-env --no-check src/api/min-balance-functions.test.ts"
  },
  "fmt": {
    "singleQuote": true,
    "lineWidth": 120,
    "useTabs": false,
    "semiColons": true
  },
  "imports": {
    "@std/testing": "jsr:@std/testing@^1.0.16",
    "@std/assert": "jsr:@std/assert@^1.0.16",
    "@cowprotocol/cow-sdk": "npm:@cowprotocol/cow-sdk@^5.10.2",
    "@kpk/gnosis-pay-rewards-sdk": "../../packages/sdk/index.js",
    "@kpk/gnosis-pay-rewards-sdk/api": "../../packages/sdk/api/index.js",
    "@kpk/gnosis-pay-rewards-sdk/mongoose": "../../packages/sdk/mongoose/index.js",
    "@kpk/apps-sdk": "npm:@kpkpkg/apps-sdk@0.1.15-rc.3",
    "@kpkpkg/apps-sdk": "npm:@kpkpkg/apps-sdk@0.1.15-rc.3",
    "@oak/oak": "jsr:@oak/oak@^17.1.4",
    "@sentry/node": "npm:@sentry/node@^8.25.0",
    "@std/dotenv": "jsr:@std/dotenv@^0.225.3",
    "axios": "npm:axios@^1.13.2",
    "async-retry": "npm:async-retry@^1.3.3",
    "cors": "npm:cors@^2.8.5",
    "dayjs": "npm:dayjs@^1.11.7",
    "deep-object-diff": "npm:deep-object-diff@^1.1.9",
    "mongoose": "npm:mongoose@^8.5.1",
    "mongoose-paginate-v2": "npm:mongoose-paginate-v2@^1.9.0",
    "redis": "npm:redis@^4.6.13",
    "viem": "npm:viem@^2.7.16",
    "winston": "npm:winston@^3.17.0",
    "winston-daily-rotate-file": "npm:winston-daily-rotate-file@^5.0.0",
    "winston-mongodb": "npm:winston-mongodb@^6.0.0",
    "zod": "npm:zod@^3.22.4",
    "@/": "./src/"
  },
  "compilerOptions": {
    "strict": true,
    "strictNullChecks": true
  },
  "nodeModulesDir": "auto"
}
