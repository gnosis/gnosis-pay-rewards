{
  "name": "@kpk/gnosis-pay-rewards-sdk",
  "private": false,
  "version": "7.1.0-rc.0",
  "type": "module",
  "files": [
    "src",
    "dist",
    "package.json",
    "mongoose"
  ],
  "main": "./dist/_cjs/index.cjs",
  "module": "./dist/_esm/index.js",
  "types": "./dist/_types/index.d.ts",
  "typings": "./dist/_types/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/_types/index.d.ts",
      "import": "./dist/_esm/index.js",
      "require": "./dist/_cjs/index.cjs",
      "node": "./dist/_cjs/index.cjs",
      "source": "./src/index.ts"
    },
    "./api": {
      "types": "./dist/_types/api/index.d.ts",
      "import": "./dist/_esm/api/index.esm.js",
      "require": "./dist/_cjs/api/index.cjs",
      "node": "./dist/_cjs/api/index.cjs",
      "source": "./src/api/index.ts"
    },
    "./mongoose": {
      "types": "./dist/_types/mongoose/index.d.ts",
      "import": "./dist/_esm/mongoose/index.esm.js",
      "require": "./dist/_cjs/mongoose/index.cjs",
      "node": "./dist/_cjs/mongoose/index.cjs",
      "source": "./src/mongoose/index.ts"
    }
  },
  "typesVersions": {
    "*": {
      "api": [
        "./dist/_types/api/index.d.ts"
      ],
      "mongoose": [
        "./dist/_types/mongoose/index.d.ts"
      ]
    }
  },
  "scripts": {
    "dev": "rollup -c -w",
    "lint": "prettier --check src/ && eslint src/",
    "format": "prettier --write src/ && eslint src/ --fix",
    "typechain": "node --experimental-specifier-resolution=node ./bin/typechain.js",
    "codegen:graphql": "graphql-codegen --config graphql-codegen.yml",
    "clean": "rimraf ./dist",
    "build": "pnpm clean && rollup -c",
    "test": "jest --passWithNoTests",
    "codegen": "echo 'No codegen for this package'",
    "prepublishOnly": "pnpm test && pnpm build",
    "show-gno-effects": "npx tsx src/scripts/showGnoBalanceEffects.ts",
    "show-metri-rewards": "npx tsx src/scripts/showMetriRewards.ts"
  },
  "dependencies": {
    "debug": "^4.3.4"
  },
  "devDependencies": {
    "@babel/core": "^7.21.4",
    "@babel/preset-env": "^7.21.4",
    "@babel/preset-typescript": "^7.22.5",
    "@jest/globals": "^29.7.0",
    "@kpk/rollup-config": "workspace:*",
    "@types/debug": "^4.1.8",
    "@types/jest": "^29.5.14",
    "@types/memoizee": "^0.4.8",
    "@types/node": "^18.15.11",
    "abitype": "^0.2.5",
    "babel-jest": "^29.5.0",
    "dotenv": "^16.0.3",
    "eslint": "^9.39.1",
    "jest": "^29.7.0",
    "rimraf": "3.0.2",
    "rollup": "^3.20.2",
    "ts-jest": "^29.1.0",
    "ts-node": "^10.9.1",
    "tslib": "^2.5.0",
    "typescript": "^5.6.3"
  },
  "peerDependencies": {
    "@cowprotocol/cow-sdk": "^5.10.2",
    "dayjs": "^1.11.7",
    "mongoose": "^8.5.1",
    "mongoose-paginate-v2": "^1.9.0",
    "socket.io": "^4.7.5",
    "viem": "2.7.16",
    "zod": "^3.25.76",
    "@kpkpkg/apps-sdk": "0.1.15-rc.3"
  }
}